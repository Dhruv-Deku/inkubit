# Copy to .env and fill in. .env is gitignored.
# Meta Model API key (starts with LLM_). MODEL_API_KEY is also accepted.
META_API_KEY=

# meta = real Meta Model API calls, mock = deterministic offline adapters
INKUBIT_MODEL_PROVIDER=mock

# 1 = if a live Meta call fails, fall back to the mock and label the result "mock fallback"
INKUBIT_ALLOW_FALLBACK=1

# Optional model overrides (defaults come from docs/meta-api/models.md)
# INKUBIT_REASONING_MODEL=muse-spark-1.3
# INKUBIT_CODE_MODEL=muse-spark-1.3
# INKUBIT_IMAGE_MODEL=muse-image-1.0
# INKUBIT_SEGMENT_MODEL=sam-3.1
