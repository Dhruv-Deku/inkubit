{
  "title": "Entanglement, three qubits",
  "made_by": "scripts/make_lecture.py (pen sketch drawn in stages; Windows speech voices David and Zira)",
  "video": "lecture.mp4",
  "sha256": "32d834423f9df02a5ebf036a81ed7e6d00780af4528fe9fc3b04b5f622e3561d",
  "duration": 50.81,
  "width": 1280,
  "height": 720,
  "turns": [
    {
      "index": 0,
      "speaker": "Teacher",
      "voice": "Microsoft David Desktop",
      "start": 0.8,
      "end": 6.24,
      "text": "Today we build an entangled state on three qubits. Three wires, all starting at zero."
    },
    {
      "index": 1,
      "speaker": "Teacher",
      "voice": "Microsoft David Desktop",
      "start": 8.14,
      "end": 13.22,
      "text": "A Hadamard on the first qubit. Now it reads zero or one, each half of the time."
    },
    {
      "index": 2,
      "speaker": "Teacher",
      "voice": "Microsoft David Desktop",
      "start": 15.12,
      "end": 22.46,
      "text": "A CNOT from the first qubit to the second. Now these two are entangled: we only ever see zero zero, or one one."
    },
    {
      "index": 3,
      "speaker": "Student",
      "voice": "Microsoft Zira Desktop",
      "start": 22.96,
      "end": 25.95,
      "text": "And the third qubit is entangled with them too, right?"
    },
    {
      "index": 4,
      "speaker": "Teacher",
      "voice": "Microsoft David Desktop",
      "start": 26.45,
      "end": 29.72,
      "text": "Not yet. The third qubit is still just zero."
    },
    {
      "index": 5,
      "speaker": "Teacher",
      "voice": "Microsoft David Desktop",
      "start": 31.62,
      "end": 40.82,
      "text": "One more CNOT, from the second qubit to the third. Now all three are entangled. This is the W state: exactly one of the three qubits reads one."
    },
    {
      "index": 6,
      "speaker": "Teacher",
      "voice": "Microsoft David Desktop",
      "start": 42.72,
      "end": 48.31,
      "text": "When we measure, we get zero zero zero, or one one one, each with probability one half."
    }
  ],
